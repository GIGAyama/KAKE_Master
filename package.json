{
  "name": "kake-master",
  "version": "1.4.0",
  "private": true,
  "description": "九九カード - かけざんアプリ（GIGA Standard v5 準拠）",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check": "node tools/build-sw.mjs --check && node scripts/check-project.mjs",
    "build:sw": "node tools/build-sw.mjs",
    "check:self-test": "node scripts/check-project.mjs --self-test",
    "test": "node --test tests/*.test.mjs",
    "measure:ui": "node tools/measure-ui.mjs",
    "measure:pwa": "node tools/measure-pwa.mjs",
    "measure:icons": "node tools/measure-icons.mjs",
    "smoke": "node tools/smoke.mjs",
    "icons": "node tools/optimize-icons.mjs"
  },
  "devDependencies": {
    "playwright": "1.49.1",
    "sharp": "^0.33.5"
  },
  "devDependenciesNote": "playwright と sharp は tools/ の実測ツール専用。品質ゲート(npm run check)と npm test は依存なしで動くため、CI では入れない。"
}
